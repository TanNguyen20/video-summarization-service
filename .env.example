# ──────────────────────────────────────────────────────────
#  Video Summarization API — Environment Configuration
# ──────────────────────────────────────────────────────────
#  Copy this file to .env and adjust values as needed.
#  All settings below show their DEFAULT values.
# ──────────────────────────────────────────────────────────

# === Server ===
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# === Database (PostgreSQL) ===
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/video_summarization

# === Whisper (Speech-to-Text) ===
WHISPER_MODEL_SIZE=large-v2
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=float16

# === LLM (Summarization via Ollama) ===
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_TIMEOUT=120
LLM_MODEL=llama3

# === TTS (Text-to-Speech) ===
DEFAULT_TTS_LANG=vi
FPT_API_KEY=

# === Upload Limits ===
MAX_FILE_SIZE_MB=500
ALLOWED_EXTENSIONS=.mp4,.mkv,.avi,.mov,.webm

# === Directories ===
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
