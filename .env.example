# ──────────────────────────────────────────────────────────
#  Video Summarization API — Environment Configuration
# ──────────────────────────────────────────────────────────
#  Copy this file to .env and adjust values as needed.
#  All settings below show their DEFAULT values.
# ──────────────────────────────────────────────────────────

# === Server ===
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# === Database (PostgreSQL) ===
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/video_summarization

# === Whisper (Local Speech-to-Text) ===
WHISPER_MODEL_SIZE=large-v2
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=float16

# === LLM — Local (Ollama) ===
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_TIMEOUT=120
LLM_MODEL=qwen3:14b
# Keep false for thinking models (qwen3): thinking + format=json yields "{}"
LLM_THINK=false

# === Cloud Providers (set API keys to enable) ===
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TTS_VOICE=alloy
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ASSEMBLYAI_API_KEY=
ELEVENLABS_API_KEY=
# Premade voices work on the free tier; Voice Library voices need Creator tier for API use
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# Vietnamese needs a v2.5+ model (eleven_multilingual_v2 rejects 'vi')
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# === TTS (Text-to-Speech) ===
DEFAULT_TTS_LANG=vi
FPT_API_KEY=

# === Upload Limits ===
MAX_FILE_SIZE_MB=500
ALLOWED_EXTENSIONS=.mp4,.mkv,.avi,.mov,.webm

# === Directories ===
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
